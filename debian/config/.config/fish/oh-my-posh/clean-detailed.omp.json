{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#cad3f5",
          "foreground": "#24273a",
          "leading_diamond": "\ue0b2",
          "properties": {
            "macos": "\uf179 ",
            "ubuntu": "\uf31b ",
            "windows": "\ue62a "
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "trailing_diamond": "<transparent,#cad3f5>\ue0b2</>",
          "type": "os"
        },
        {
          "background": "#cad3f5",
          "foreground": "#24273a",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf489 {{ .Name }} ",
          "trailing_diamond": "<transparent,#cad3f5>\ue0b2</>",
          "type": "shell"
        },
        {
          "background": "#ed8796",
          "foreground": "#24273a",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf09c admin ",
          "trailing_diamond": "<transparent,#ed8796>\ue0b2</>",
          "type": "root"
        },
        {
          "background": "#8aadf4",
          "foreground": "#24273a",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \ue266 MEM: {{ round .PhysicalPercentUsed .Precision }}% | RAM: {{ (div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1000000000.0) }}/{{ (div .PhysicalTotalMemory 1000000000.0) }}GB \ue266 ",
          "trailing_diamond": "<transparent,#8aadf4>\ue0b2</>",
          "type": "sysinfo"
        },
        {
          "type": "cmake",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#24273a",
          "background": "#a6da95",
          "trailing_diamond": "<transparent,#a6da95>\ue0b2</>",
          "template": " \ue61e \ue61d cmake {{ .Full }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "properties": {
            "display_mode": "context"
          },
          "foreground": "#24273a",
          "background": "#eed49f",
          "trailing_diamond": "<transparent,#eed49f>\ue0b2</>",
          "template": " \ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#24273a",
          "background": "#7dc4e4",
          "trailing_diamond": "<transparent,#7dc4e4>\ue0b2</>",
          "template": " \u202d\ue626 {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#24273a",
          "background": "#f5a97f",
          "trailing_diamond": "<transparent,#f5a97f>\ue0b2</>",
          "template": " \ue7a8 {{ .Full }} "
        },
        {
          "background": "#494d64",
          "foreground": "#cad3f5",
          "leading_diamond": "\ue0b2",
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": " {{ .FormattedMs }} ",
          "trailing_diamond": "\ue0b0",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#a6da95",
          "foreground": "#24273a",
          "leading_diamond": "\ue0b2",
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b0",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "template": "\u256d\u2500",
          "type": "text"
        },
        {
          "properties": {
            "time_format": "<#cad3f5>\ue641 15:04:05</> <#8bd5ca>|</> \uf073 2 Jan, Monday"
          },
          "style": "plain",
          "template": " {{ .CurrentDate | date .Format }} <#8bd5ca>|</>",
          "type": "time"
        },
        {
          "style": "plain",
          "template": " \uf292 ",
          "type": "root"
        },
        {
          "properties": {
            "folder_icon": " \uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\ueb06 ",
            "style": "agnoster_short",
            "max_depth": 3
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u2570\u2500 ",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "{{ if .Error }}<#ed8796, transparent>[{{ reason .Code }}]</>{{ else }}<#a6da95, transparent>[SUCCESS]</>{{ end }} ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ if .Root }}root @ {{ end }}{{ .Shell }} in {{ .HostName }}",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#cad3f5",
    "template": "\ue285 "
  },
  "version": 2
}

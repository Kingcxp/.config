{
    // 合并到单个科研项目的 .vscode/settings.json，先确认这些目录不存放源码。
    // 不要把整个主目录、通用 data/ 或 build/ 盲目排除。
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/datasets/**": true,
        "**/checkpoints/**": true,
        "**/wandb/**": true,
        "**/runs/**": true
    },
    "search.exclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/datasets/**": true,
        "**/checkpoints/**": true,
        "**/wandb/**": true,
        "**/runs/**": true
    },
    // 自定义 exclude 时显式保留常见缓存/环境项；导入的 Python 文件仍可能被分析。
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.git",
        "**/.venv",
        "**/datasets",
        "**/checkpoints",
        "**/wandb",
        "**/runs"
    ],
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.diagnosticMode": "openFilesOnly"
}
